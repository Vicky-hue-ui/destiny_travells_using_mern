# Copy this file to ".env" and fill in your own values.
# The real .env file is listed in .gitignore and must never be committed.

PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/destiny_travels

# MongoDB Atlas (replace user, password and cluster; keep /destiny_travels as the database name):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/destiny_travels?retryWrites=true&w=majority
